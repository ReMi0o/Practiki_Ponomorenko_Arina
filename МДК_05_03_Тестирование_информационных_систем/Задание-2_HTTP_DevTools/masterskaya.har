SSID","value":"jeaf6pgth79isksmmo3ftjtsu5"}],"headers":[{"name":"Accept","value":"text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.7"},{"name":"Accept-Encoding","value":"gzip, deflate, br, zstd"},{"name":"Cache-Control","value":"max-age=0"},{"name":"Connection","value":"keep-alive"},{"name":"Cookie","value":"PHPSESSID=jeaf6pgth79isksmmo3ftjtsu5"},{"name":"Host","value":"127.0.0.1:8000"},{"name":"Referer","value":"http://127.0.0.1:8000/login"},{"name":"Sec-Fetch-Dest","value":"document"},{"name":"Sec-Fetch-Mode","value":"navigate"},{"name":"Sec-Fetch-Site","value":"same-origin"},{"name":"Sec-Fetch-User","value":"?1"},{"name":"Upgrade-Insecure-Requests","value":"1"},{"name":"User-Agent","value":"Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) HeadlessChrome/153.0.8010.12 Safari/537.36"},{"name":"sec-ch-ua","value":"\"HeadlessChrome\";v=\"153\", \"Not_A Brand\";v=\"8\", \"Chromium\";v=\"153\""},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"sec-ch-ua-platform","value":"\"Linux\""}],"queryString":[],"headersSize":753,"bodySize":0},"response":{"status":200,"statusText":"OK","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Cache-Control","value":"no-store, no-cache, must-revalidate"},{"name":"Connection","value":"close"},{"name":"Content-type","value":"text/html; charset=UTF-8"},{"name":"Date","value":"Tue, 03 Nov 2026 21:01:16 GMT"},{"name":"Expires","value":"Thu, 19 Nov 1981 08:52:00 GMT"},{"name":"Host","value":"127.0.0.1:8000"},{"name":"Pragma","value":"no-cache"},{"name":"X-Powered-By","value":"PHP/8.3.6"}],"content":{"size":3281,"mimeType":"text/html; charset=UTF-8","compression":0,"text":"<!DOCTYPE html>\n<html lang=\"ru\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <meta name=\"theme-color\" content=\"#0f766e\">\n    <title>Мастерская идей — запись на мастер-классы</title>\n    <link rel=\"stylesheet\" href=\"/assets/css/main.css\">\n    <link rel=\"stylesheet\" href=\"/assets/css/motion.css\">\n</head>\n<body>\n<header class=\"top\">\n    <div class=\"wrap top__row\">\n        <a href=\"/\" class=\"brand\"><span class=\"brand__mark\">М</span> Мастерская идей</a>\n        <details class=\"mnav\">\n            <summary class=\"mnav__btn\" aria-label=\"Открыть меню\">Меню</summary>\n        </details>\n        <nav class=\"menu\" id=\"menu\">\n            <a href=\"/\">Афиша</a>\n                            <a href=\"/cabinet\">Личный кабинет</a>\n                <a href=\"/booking\">Записаться</a>\n                                        <span class=\"menu__who\">leila_h</span>\n                <a href=\"/logout\">Выход</a>\n                    </nav>\n    </div>\n</header>\n<main class=\"wrap page\">\n        <div class=\"head-line\">\n    <h1>Мои заявки</h1>\n    <a class=\"btn\" href=\"/booking\">Записаться ещё</a>\n</div>\n    <div class=\"cards\">\n        <article class=\"card\">\n    <header class=\"card__head\">\n        <span class=\"card__no\">Заявка № 5</span>\n        <span class=\"tag tag--s3\">Завершено</span>\n    </header>\n    <h2 class=\"card__title\">Гончарный круг для начинающих</h2>\n    <ul class=\"card__facts\">\n        <li><b>Дата:</b> 18 октября 2026, 12:00</li>\n                <li><b>Помещение:</b> Мастерская керамики</li>\n        <li><b>Оплата:</b> Наличными на месте</li>\n            </ul>\n                        <a class=\"btn btn--line\" href=\"/feedback?id=5\">Оставить отзыв</a>\n            </article>\n<article class=\"card\">\n    <header class=\"card__head\">\n        <span class=\"card__no\">Заявка № 4</span>\n        <span class=\"tag tag--s1\">Новая</span>\n    </header>\n    <h2 class=\"card__title\">Figma: прототип мобильного приложения</h2>\n    <ul class=\"card__facts\">\n        <li><b>Дата:</b> 29 ноября 2026, 11:00</li>\n                <li><b>Помещение:</b> Онлайн (ссылка придёт на почту)</li>\n        <li><b>Оплата:</b> Банковская карта онлайн</li>\n        <li><b>Пожелания:</b> Нужна запись занятия</li>    </ul>\n                        <p class=\"muted\">Отзыв можно будет оставить после занятия</p>\n            </article>\n    </div>\n</main>\n<footer class=\"bottom\"><div class=\"wrap\">Мастерская идей, 2026 · учебный проект</div></footer>\n<script>\n    // ПР 13: на телефоне меню открывается кнопкой «Меню» (элемент details)\n    document.querySelector('.mnav').addEventListener('toggle', e =>\n        document.getElementById('menu').classList.toggle('menu--open', e.target.open));\n</script>\n<script src=\"/assets/js/motion.js\" defer></script>\n</body>\n</html>\n"},"headersSize":272,"bodySize":3281,"redirectURL":"","_transferSize":3553},"cache":{},"timings":{"dns":0.009,"connect":1.221,"ssl":2.357,"send":0,"wait":2.13,"receive":1.155},"_frameref":"frame@6b151b6e368ba26f867c66aa1185bc5c","_monotonicTime":1296.441,"_resourceType":"document","serverIPAddress":"127.0.0.1","_serverPort":8000,"_securityDetails":{}},{"pageref":"page@2e8929437642dd9d370d675279e5aa79","startedDateTime":"2026-11-03T21:01:16.757Z","time":5.303999999999999,"request":{"method":"GET","url":"http://127.0.0.1:8000/assets/css/main.css","httpVersion":"HTTP/1.1","cookies":[{"name":"PHPSESSID","value":"jeaf6pgth79isksmmo3ftjtsu5"}],"headers":[{"name":"Accept","value":"text/css,*/*;q=0.1"},{"name":"Accept-Encoding","value":"gzip, deflate, br, zstd"},{"name":"Connection","value":"keep-alive"},{"name":"Cookie","value":"PHPSESSID=jeaf6pgth79isksmmo3ftjtsu5"},{"name":"Host","value":"127.0.0.1:8000"},{"name":"Referer","value":"http://127.0.0.1:8000/cabinet"},{"name":"Sec-Fetch-Dest","value":"style"},{"name":"Sec-Fetch-Mode","value":"no-cors"},{"name":"Sec-Fetch-Site","value":"same-origin"},{"name":"User-Agent","value":"Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) HeadlessChrome/153.0.8010.12 Safari/537.36"},{"name":"sec-ch-ua","value":"\"HeadlessChrome\";v=\"153\", \"Not_A Brand\";v=\"8\", \"Chromium\";v=\"153\""},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"sec-ch-ua-platform","value":"\"Linux\""}],"queryString":[],"headersSize":570,"bodySize":0},"response":{"status":200,"statusText":"OK","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Connection","value":"close"},{"name":"Content-Length","value":"8462"},{"name":"Content-Type","value":"text/css; charset=UTF-8"},{"name":"Date","value":"Tue, 03 Nov 2026 21:01:16 GMT"},{"name":"Host","value":"127.0.0.1:8000"}],"content":{"size":8462,"mimeType":"text/css; charset=UTF-8","compression":0,"text":"/* Мастерская идей — стили (ПР 3) */\n* { box-sizing: border-box; }\nbody { margin: 0; font-family: \"Segoe UI\", Roboto, Helvetica, sans-serif; font-size: 16px;\n       color: #2b2622; background: #faf7f2; }\na { color: #0f766e; }\n.wrap { width: min(1000px, 100% - 40px); margin: 0 auto; }\n.top { background: #ffffff; border-bottom: 3px solid #0f766e; }\n.top__row { display: flex; align-items: center; justify-content: space-between; height: 70px; }\n.brand { display: flex; align-items: center; gap: 10px; font-size: 21px; font-weight: 700; color: #2b2622; text-decoration: none; }\n.brand__mark { display: inline-grid; place-items: center; width: 36px; height: 36px; border-radius: 50%;\n               background: #f97316; color: #fff; }\n.menu a { margin-left: 20px; text-decoration: none; color: #2b2622; font-weight: 600; }\n.menu__who { margin-left: 20px; color: #6f675f; }\n.menu__accent { background: #0f766e; color: #fff !important; padding: 8px 14px; border-radius: 20px; }\n.page { padding: 28px 0 60px; min-height: 70vh; }\n.hero { background: #e6f2f0; padding: 24px 28px; border-radius: 14px; margin-bottom: 24px; }\n.hero h1 { margin: 0 0 6px; }\n.grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }\n.ws { background: #fff; border-radius: 14px; padding: 20px; border: 1px solid #ece5da; }\n.ws__when { color: #c2410c; font-weight: 700; margin: 0; }\n.ws__title { font-size: 19px; margin: 8px 0; }\n.ws__meta { color: #6f675f; font-size: 14px; }\n.btn { display: inline-block; background: #c2410c; color: #fff; border: none; border-radius: 22px;\n       padding: 10px 22px; font: inherit; font-weight: 600; cursor: pointer; text-decoration: none; }\n.btn--sm { padding: 6px 12px; }\n.box { background: #fff; width: 100%; max-width: 460px; padding: 26px; border-radius: 14px; border: 1px solid #ece5da; }\n.box label { display: block; margin-bottom: 14px; font-weight: 600; }\n.box input, .box select, .box textarea { display: block; width: 100%; margin-top: 6px; padding: 9px 12px;\n       border: 1px solid #cfc6b8; border-radius: 8px; font: inherit; font-weight: 400; }\n.errors { background: #fdecea; color: #b42318; padding: 12px 12px 12px 32px; border-radius: 10px; max-width: 460px; }\n.note { padding: 12px 16px; border-radius: 10px; }\n.note--ok { background: #dcf3ea; color: #05603a; }\n.note--error { background: #fdecea; color: #b42318; }\n.tbl { width: 100%; border-collapse: collapse; background: #fff; }\n.tbl th, .tbl td { padding: 10px; border-bottom: 1px solid #ece5da; text-align: left; vertical-align: top; }\n.tbl th { background: #e6f2f0; }\n.row { display: flex; gap: 6px; }\n.oops { text-align: center; padding: 60px 0; }\n.oops__code { font-size: 72px; font-weight: 800; color: #0f766e; margin: 0; }\n.bottom { background: #2b2622; color: #cfc6b8; padding: 18px 0; font-size: 14px; }\n\n/* ===== ПР 9: поля с ошибками, карточки, фильтр, отзывы ===== */\n.field { margin-bottom: 16px; }\n.field label, .field legend { display: block; font-weight: 600; margin-bottom: 6px; }\n.field input, .field select, .field textarea { display: block; width: 100%; padding: 9px 12px;\n       border: 1px solid #cfc6b8; border-radius: 8px; font: inherit; background: #fff; }\n.field__hint { display: block; color: #6f675f; font-size: 13px; margin-top: 4px; }\n.field__hint--warn { color: #c2410c; font-weight: 600; }\n.field__error { display: block; color: #b42318; font-size: 14px; margin-top: 4px; }\n.field--bad input, .field--bad select, .field--bad textarea { border-color: #d92d20; background: #fff6f5; }\n.opt { font-weight: 400; color: #6f675f; }\n.box__alt { margin-bottom: 0; }\n.head-line { display: flex; align-items: center; justify-content: space-between; }\n.cards { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; }\n.card { background: #fff; border: 1px solid #ece5da; border-radius: 14px; padding: 18px 20px; }\n.card__head { display: flex; justify-content: space-between; align-items: center; }\n.card__no { color: #6f675f; font-size: 14px; }\n.card__title { font-size: 18px; margin: 10px 0; }\n.card__facts { list-style: none; padding: 0; margin: 0 0 14px; font-size: 15px; line-height: 1.6; }\n.card__facts b { color: #5c544c; font-weight: 600; }\n.card__form { display: flex; gap: 8px; }\n.card__form select { flex: 1; padding: 6px 10px; border: 1px solid #cfc6b8; border-radius: 8px; font: inherit; }\n.tag { font-size: 13px; font-weight: 700; padding: 4px 12px; border-radius: 12px; }\n.tag--s1 { background: #fff1e6; color: #c2410c; }\n.tag--s2 { background: #e0eefe; color: #1d4ed8; }\n.tag--s3 { background: #dcf3ea; color: #05603a; }\n.filter { display: flex; gap: 10px; margin-bottom: 20px; flex-wrap: wrap; }\n.filter__item { padding: 7px 16px; border-radius: 20px; border: 1px solid #cfc6b8; text-decoration: none;\n                color: #2b2622; background: #fff; font-weight: 600; }\n.filter__item span { color: #6f675f; font-weight: 400; margin-left: 4px; }\n.filter__item.is-on { background: #0f766e; border-color: #0f766e; color: #fff; }\n.filter__item.is-on span { color: #c7ebe5; }\n.quote { margin: 0 0 14px; background: #faf7f2; border-left: 4px solid #f97316; padding: 10px 14px; border-radius: 0 8px 8px 0; }\n.quote__stars { display: block; color: #f59e0b; letter-spacing: 2px; }\n.btn--line { background: transparent; color: #c2410c; border: 2px solid #c2410c; }\n.muted { color: #6f675f; font-size: 14px; }\n.lead { color: #5c544c; }\n.stars-pick { border: none; padding: 0; display: flex; flex-direction: row-reverse; justify-content: flex-end; flex-wrap: wrap; }\n.stars-pick legend { width: 100%; }\n.stars-pick input { position: absolute; opacity: 0; }\n.stars-pick label { font-size: 34px; color: #d6cfc4; cursor: pointer; margin: 0 2px 0 0; }\n.stars-pick input:checked ~ label, .stars-pick label:hover, .stars-pick label:hover ~ label { color: #f59e0b; }\n.stars-pick .field__error { order: -1; width: 100%; }\n\n\n/* ===== ПР 13: адаптивная вёрстка (mobile: 390×844) ===== */\nimg { max-width: 100%; height: auto; }\n.mnav { display: none; }\n.grid { grid-template-columns: repeat(auto-fit, minmax(270px, 1fr)); }\n.tbl { display: block; overflow-x: auto; }\n\n@media (max-width: 900px) {\n    .cards { grid-template-columns: 1fr; }\n    .hero { padding: 20px; }\n}\n\n@media (max-width: 700px) {\n    body { font-size: 16px; }\n    .top__row { height: 60px; position: relative; }\n    .brand { font-size: 18px; }\n    .brand__mark { width: 32px; height: 32px; }\n    .mnav { display: block; }\n    .mnav__btn { list-style: none; cursor: pointer; padding: 10px 16px; border-radius: 20px;\n                 background: #0f766e; color: #fff; font-weight: 600; min-height: 44px; display: flex; align-items: center; }\n    .mnav__btn::-webkit-details-marker { display: none; }\n    .mnav[open] .mnav__btn { background: #2b2622; }\n    .menu { display: none; position: absolute; z-index: 20; top: 60px; left: -20px; right: -20px;\n            background: #fff; border-bottom: 3px solid #0f766e; box-shadow: 0 12px 24px rgba(43, 38, 34, .15);\n            padding: 6px 20px 14px; flex-direction: column; }\n    .menu--open { display: flex; }\n    .menu a, .menu__who { margin: 0; padding: 14px 4px; border-bottom: 1px solid #ece5da; }\n    .menu__accent { margin-top: 12px !important; text-align: center; border-bottom: none !important; }\n    h1 { font-size: 26px; line-height: 1.2; }\n    .page { padding: 18px 0 40px; }\n    .head-line { flex-direction: column; align-items: stretch; gap: 4px; margin-bottom: 14px; }\n    .head-line .btn { text-align: center; }\n    .box { padding: 18px 16px; border-radius: 12px; }\n    .btn { min-height: 46px; display: inline-flex; align-items: center; justify-content: center; }\n    .box .btn, .card__form .btn { width: 100%; }\n    .field input, .field select, .field textarea { min-height: 46px; font-size: 16px; }\n    .card { padding: 16px; }\n    .card__form { flex-direction: column; }\n    .card__form select { min-height: 44px; font-size: 16px; }\n    .filter { flex-wrap: nowrap; overflow-x: auto; padding-bottom: 6px; margin: 0 -20px 16px; padding-left: 20px; padding-right: 20px; }\n    .filter__item { white-space: nowrap; min-height: 40px; display: inline-flex; align-items: center; }\n    .stars-pick label { font-size: 40px; }\n    .bottom { text-align: center; }\n}\n.card__form select { background: #fff; }\nbody { min-height: 100vh; display: flex; flex-direction: column; }\n.page { flex: 1; min-height: 0; width: min(1000px, 100% - 40px); }\n"},"headersSize":158,"bodySize":8462,"redirectURL":"","_transferSize":8620},"cache":{},"timings":{"dns":0.007,"connect":0.126,"ssl":1.271,"send":0,"wait":2.252,"receive":1.648},"_frameref":"frame@6b151b6e368ba26f867c66aa1185bc5c","_monotonicTime":1323.563,"_resourceType":"stylesheet","serverIPAddress":"127.0.0.1","_serverPort":8000,"_securityDetails":{}},{"pageref":"page@2e8929437642dd9d370d675279e5aa79","startedDateTime":"2026-11-03T21:01:16.758Z","time":6.017,"request":{"method":"GET","url":"http://127.0.0.1:8000/assets/css/motion.css","httpVersion":"HTTP/1.1","cookies":[{"name":"PHPSESSID","value":"jeaf6pgth79isksmmo3ftjtsu5"}],"headers":[{"name":"Accept","value":"text/css,*/*;q=0.1"},{"name":"Accept-Encoding","value":"gzip, deflate, br, zstd"},{"name":"Connection","value":"keep-alive"},{"name":"Cookie","value":"PHPSESSID=jeaf6pgth79isksmmo3ftjtsu5"},{"name":"Host","value":"127.0.0.1:8000"},{"name":"Referer","value":"http://127.0.0.1:8000/cabinet"},{"name":"Sec-Fetch-Dest","value":"style"},{"name":"Sec-Fetch-Mode","value":"no-cors"},{"name":"Sec-Fetch-Site","value":"same-origin"},{"name":"User-Agent","value":"Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) HeadlessChrome/153.0.8010.12 Safari/537.36"},{"name":"sec-ch-ua","value":"\"HeadlessChrome\";v=\"153\", \"Not_A Brand\";v=\"8\", \"Chromium\";v=\"153\""},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"sec-ch-ua-platform","value":"\"Linux\""}],"queryString":[],"headersSize":572,"bodySize":0},"response":{"status":200,"statusText":"OK","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Connection","value":"close"},{"name":"Content-Length","value":"5498"},{"name":"Content-Type","value":"text/css; charset=UTF-8"},{"name":"Date","value":"Tue, 03 Nov 2026 21:01:16 GMT"},{"name":"Host","value":"127.0.0.1:8000"}],"content":{"size":5498,"mimeType":"text/css; charset=UTF-8","compression":0,"text":"/* ===== ПР 14. Анимации и микро-анимации =====\n   Правило: двигаем только transform и opacity — они не вызывают пересчёт раскладки страницы. */\n\n:root {\n    --spring: cubic-bezier(.34, 1.56, .64, 1);   /* лёгкий «пружинящий» выход */\n    --smooth: cubic-bezier(.4, 0, .2, 1);\n}\n\n/* 1. Переход между страницами — View Transitions API (браузер сам делает плавную смену страниц) */\n@view-transition { navigation: auto; }\n::view-transition-old(root) { animation: 160ms var(--smooth) both fade-out; }\n::view-transition-new(root) { animation: 260ms var(--smooth) both slide-in; }\n@keyframes fade-out { to { opacity: 0; } }\n@keyframes slide-in { from { opacity: 0; transform: translateX(14px); } }\n.top { view-transition-name: header; }          /* шапка остаётся на месте при переходе */\n\n/* 2. Появление карточек при прокрутке (класс ставит animations.js через IntersectionObserver) */\n.reveal { opacity: 0; transform: translateY(24px); transition: opacity .5s var(--smooth), transform .5s var(--smooth); }\n.reveal.is-visible { opacity: 1; transform: none; }\n\n/* 3. Карточки: подъём при наведении */\n.ws, .card { transition: transform .25s var(--smooth), box-shadow .25s var(--smooth), opacity .5s var(--smooth); }\n@media (hover: hover) {\n    .ws:hover, .card:hover { transform: translateY(-5px); box-shadow: 0 14px 28px rgba(15, 118, 110, .14); }\n    .reveal.is-visible:hover { transform: translateY(-5px); }\n}\n\n/* 4. Кнопки: сдвиг блика при наведении и «пружина» при нажатии */\n.btn { position: relative; overflow: hidden; transition: transform .15s var(--spring), box-shadow .2s; }\n.btn::after { content: \"\"; position: absolute; inset: 0; background: linear-gradient(110deg, transparent 30%, rgba(255,255,255,.35) 50%, transparent 70%);\n              transform: translateX(-120%); transition: transform .6s var(--smooth); }\n@media (hover: hover) {\n    .btn:hover { transform: translateY(-2px); box-shadow: 0 6px 16px rgba(194, 65, 12, .35); }\n    .btn:hover::after { transform: translateX(120%); }\n}\n.btn:active { transform: scale(.95); transition-duration: .05s; }\n\n/* 5. Логотип: буква «М» поворачивается при наведении */\n.brand__mark { transition: transform .5s var(--spring); }\n.brand:hover .brand__mark { transform: rotate(-20deg) scale(1.1); }\n\n/* 6. Поля: мягкое свечение в фокусе, ошибка выезжает сверху */\n.field input, .field select, .field textarea, .card__form select { transition: border-color .2s, box-shadow .2s, background-color .2s; }\n.field input:focus, .field select:focus, .field textarea:focus, .card__form select:focus {\n    outline: none; border-color: #0f766e; box-shadow: 0 0 0 4px rgba(15, 118, 110, .18); }\n.field__error:not(:empty) { animation: drop .25s var(--smooth); }\n@keyframes drop { from { opacity: 0; transform: translateY(-6px); } }\n.field--bad.wobble { animation: wobble .4s ease; }\n@keyframes wobble { 0%, 100% { transform: none; } 25% { transform: translateX(-6px); } 50% { transform: translateX(5px); } 75% { transform: translateX(-3px); } }\n\n/* 7. Уведомления-«тосты»: выезжают справа, полоска показывает время до закрытия */\n.toasts { position: fixed; right: 20px; bottom: 20px; z-index: 50; display: flex; flex-direction: column; gap: 10px; max-width: 360px; }\n.toasts .note { margin: 0; box-shadow: 0 10px 24px rgba(43, 38, 34, .18); position: relative; overflow: hidden;\n                animation: toast-in .4s var(--spring); }\n.toasts .note::after { content: \"\"; position: absolute; left: 0; bottom: 0; height: 3px; width: 100%; background: currentColor; opacity: .5;\n                       transform-origin: left; animation: timer 5s linear forwards; }\n.toasts .note.is-gone { animation: toast-out .3s var(--smooth) forwards; }\n@keyframes toast-in { from { opacity: 0; transform: translateX(110%); } }\n@keyframes toast-out { to { opacity: 0; transform: translateX(110%); } }\n@keyframes timer { to { transform: scaleX(0); } }\n\n/* 8. Мобильное меню выпадает сверху */\n.menu--open { animation: menu-drop .25s var(--smooth); }\n@keyframes menu-drop { from { opacity: 0; transform: translateY(-12px); } }\n\n/* 9. Звёзды в форме отзыва «подпрыгивают» */\n.stars-pick label { transition: transform .2s var(--spring), color .15s; }\n.stars-pick label:hover { transform: scale(1.25); }\n.stars-pick input:checked + label { animation: pop .35s var(--spring); }\n@keyframes pop { 50% { transform: scale(1.4); } }\n\n/* 10. Статус «Новая» подсвечивается мягкой пульсацией */\n.tag--s1 { animation: glow 2.2s ease-in-out infinite; }\n@keyframes glow { 50% { box-shadow: 0 0 0 5px rgba(249, 115, 22, .15); } }\n\n/* Если в системе включено «Уменьшить движение» — отключаем анимации */\n@media (prefers-reduced-motion: reduce) {\n    *, *::before, *::after, ::view-transition-group(*), ::view-transition-old(*), ::view-transition-new(*) {\n        animation: none !important; transition: none !important; }\n    .reveal { opacity: 1; transform: none; }\n}\n"},"headersSize":158,"bodySize":5498,"redirectURL":"","_transferSize":5656},"cache":{},"timings":{"dns":0.004,"connect":0.115,"ssl":1.372,"send":0,"wait":0.437,"receive":4.089},"_frameref":"frame@6b151b6e368ba26f867c66aa1185bc5c","_monotonicTime":1323.7,"_resourceType":"stylesheet","serverIPAddress":"127.0.0.1","_serverPort":8000,"_securityDetails":{}},{"pageref":"page@2e8929437642dd9d370d675279e5aa79","startedDateTime":"2026-11-03T21:01:16.759Z","time":8.442,"request":{"method":"GET","url":"http://127.0.0.1:8000/assets/js/motion.js","httpVersion":"HTTP/1.1","cookies":[{"name":"PHPSESSID","value":"jeaf6pgth79isksmmo3ftjtsu5"}],"headers":[{"name":"Accept","value":"*/*"},{"name":"Accept-Encoding","value":"gzip, deflate, br, zstd"},{"name":"Connection","value":"keep-alive"},{"name":"Cookie","value":"PHPSESSID=jeaf6pgth79isksmmo3ftjtsu5"},{"name":"Host","value":"127.0.0.1:8000"},{"name":"Referer","value":"http://127.0.0.1:8000/cabinet"},{"name":"Sec-Fetch-Dest","value":"script"},{"name":"Sec-Fetch-Mode","value":"no-cors"},{"name":"Sec-Fetch-Site","value":"same-origin"},{"name":"User-Agent","value":"Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) HeadlessChrome/153.0.8010.12 Safari/537.36"},{"name":"sec-ch-ua","value":"\"HeadlessChrome\";v=\"153\", \"Not_A Brand\";v=\"8\", \"Chromium\";v=\"153\""},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"sec-ch-ua-platform","value":"\"Linux\""}],"queryString":[],"headersSize":556,"bodySize":0},"response":{"status":200,"statusText":"OK","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Connection","value":"close"},{"name":"Content-Length","value":"1839"},{"name":"Content-Type","value":"application/javascript"},{"name":"Date","value":"Tue, 03 Nov 2026 21:01:16 GMT"},{"name":"Host","value":"127.0.0.1:8000"}],"content":{"size":1839,"mimeType":"application/javascript","compression":0,"text":"// ПР 14: управление анимациями\nconst calm = matchMedia('(prefers-reduced-motion: reduce)').matches;\n\n// карточки появляются по мере прокрутки\nconst items = document.querySelectorAll('.ws, .card');\nif (!calm && 'IntersectionObserver' in window) {\n    const io = new IntersectionObserver(entries => {\n        entries.forEach(en => {\n            if (en.isIntersecting) {\n                en.target.classList.add('is-visible');\n                io.unobserve(en.target);\n            }\n        });\n    }, { threshold: 0.12 });\n    items.forEach((el, i) => {\n        el.classList.add('reveal');\n        el.style.transitionDelay = `${(i % 3) * 70}ms`;\n        io.observe(el);\n    });\n}\n\n// flash-сообщения превращаются во всплывающие уведомления\nconst notes = document.querySelectorAll('.page > .note');\nif (notes.length) {\n    const box = document.createElement('div');\n    box.className = 'toasts';\n    box.setAttribute('role', 'status');\n    document.body.append(box);\n    notes.forEach(n => {\n        box.append(n);\n        const close = () => {\n            n.classList.add('is-gone');\n            n.addEventListener('animationend', () => n.remove(), { once: true });\n        };\n        n.addEventListener('click', close);\n        setTimeout(close, calm ? 8000 : 5000);\n    });\n}\n\n// «встряхнуть» поля с ошибками после отправки формы\nfunction wobble() {\n    document.querySelectorAll('.field--bad').forEach(f => {\n        f.classList.remove('wobble');\n        void f.offsetWidth;          // перезапуск анимации\n        f.classList.add('wobble');\n    });\n}\nwobble();\ndocument.querySelectorAll('form[data-check]').forEach(f => f.addEventListener('submit', () => setTimeout(wobble)));\n"},"headersSize":157,"bodySize":1839,"redirectURL":"","_transferSize":1996},"cache":{},"timings":{"dns":0.003,"connect":0.077,"ssl":1.168,"send":0,"wait":0.224,"receive":6.97},"_frameref":"frame@6b151b6e368ba26f867c66aa1185bc5c","_monotonicTime":1323.741,"_resourceType":"script","serverIPAddress":"127.0.0.1","_serverPort":8000,"_securityDetails":{}},{"pageref":"page@2e8929437642dd9d370d675279